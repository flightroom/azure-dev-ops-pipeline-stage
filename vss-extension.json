{
  "manifestVersion": 1,
  "id": "flightroom-azure-devops-tasks",
  "version": "0.0.0",
  "name": "Flightroom Azure DevOps Tasks",
  "description": "Azure DevOps tasks for uploading frontend bundles and registering Docker images in Flightroom",
  "public": true,
  "galleryFlags": [
      "Public"
  ],
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "categories": [
    "Azure Pipelines"
  ],
  "icons": {
    "default": "images/extension-icon.jpeg"
  },
  "content":{
    "details":{
      "path": "overview.md"
    }
  },
  "files": [
    {
      "path": "dist",
      "addressable": true
    },
    {
      "path": "images",
      "addressable": true,
      "packagePath": "images"
    },
    {
      "path": "overview.md",
      "addressable": true
    }
  ],
  "contributions": [
    {
      "id": "microfrontend-upload",
      "type": "ms.vss-distributed-task.task",
      "targets": [
        "ms.vss-distributed-task.tasks"
      ],
      "properties": {
        "name": "dist/tasks/upload-microfrontend"
      }
    },
    {
      "id": "flightroom-register-docker-image",
      "type": "ms.vss-distributed-task.task",
      "targets": [
        "ms.vss-distributed-task.tasks"
      ],
      "properties": {
        "name": "dist/tasks/register-docker-image"
      }
    }
  ]
}
